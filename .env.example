# ==========================================
# BUILT IN TECH ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env with real secrets.

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
# Local dev: http://localhost:3000
# Production (Vercel): https://built-in-tech.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ---- BuiltInTech Database ----
# Local: mongodb://127.0.0.1:27017/builtintech
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/builtintech
# Get the exact string from Atlas -> Database -> Connect -> Drivers (copy, do not type it)
MONGODB_URI="mongodb://127.0.0.1:27017/builtintech"
MONGODB_DB_NAME="builtintech"

# ---- InsidCode Arena Database (questions, duel problems, hidden tests) ----
# Can be the same Atlas cluster with a different DB name, or a separate cluster
INSIDCODE_MONGODB_URI="mongodb://127.0.0.1:27017/insidcode"
INSIDCODE_DB_NAME="insidcode"

# ---- Google OAuth (only login method) ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Redirect URIs needed:
#   http://localhost:3000/api/auth/callback/google
#   https://built-in-tech.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- Code Execution ----
# Sign up at https://onlinecompiler.io -> API keys
ONLINECOMPILER_API_KEY="your-onlinecompiler-api-key"

# ---- AI Referee ----
# Sign up at https://console.groq.com -> API keys
GROQ_API_KEY="your-groq-api-key"
