# ==========================================
# BUILT IN TECH ENVIRONMENT CONFIGURATION
# ==========================================

# NextAuth / Auth.js Secret (generate via `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# BuiltInTech Education Database (Courses, Modules, Lessons, Progress, Ranks, Achievements, Certificates)
MONGODB_URI="mongodb://127.0.0.1:27017/builtintech"
MONGODB_DB_NAME="builtintech"

# InsidCode Arena / ClashJudge Database (330 Arena Questions, Duel Rooms, Submissions)
# If hosted on the same Atlas cluster, URI can be identical while DB name is "insidcode"
INSIDCODE_MONGODB_URI="mongodb://127.0.0.1:27017/insidcode"
INSIDCODE_DB_NAME="insidcode"

# Google OAuth 2.0 Credentials (Mandatory: Google OAuth ONLY)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OnlineCompiler.io Execution API Key (multi-language code runner)
ONLINECOMPILER_API_KEY="your-onlinecompiler-api-key"

# Groq AI Referee API Key (powers LLM qualitative code critique)
GROQ_API_KEY="your-groq-api-key"
