# ==========================================
# BUILT IN TECH ENVIRONMENT CONFIGURATION
# ==========================================

# NextAuth / Auth.js Secret (generate via `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# MongoDB Database Connection String (MongoDB Atlas or local)
MONGODB_URI="mongodb://127.0.0.1:27017/builtintech"

# Google OAuth 2.0 Credentials (Mandatory: Google OAuth ONLY)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OnlineCompiler.io Execution API Key (multi-language code runner)
ONLINECOMPILER_API_KEY="your-onlinecompiler-api-key"

# Groq AI Referee API Key (powers LLM qualitative code critique with openai/gpt-oss-20b)
GROQ_API_KEY="your-groq-api-key"
