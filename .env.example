# ==========================================
# CLASHJUDGE ENVIRONMENT CONFIGURATION
# ==========================================

# NextAuth / Auth.js Secret (generate via `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# MongoDB Database Connection String
MONGODB_URI="mongodb://127.0.0.1:27017/clashjudge"

# OnlineCompiler.io Execution API Key (multi-language code runner)
ONLINECOMPILER_API_KEY="your-onlinecompiler-api-key"

# Groq AI Referee API Key (powers LLM qualitative code critique with gpt-oss-20b)
GROQ_API_KEY="your-groq-api-key"

# Optional: Google OAuth 2.0 Credentials (for 1-click social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: SMTP / Resend Email Configuration (for OTP delivery; falls back to dev logging if unset)
RESEND_API_KEY=""
EMAIL_FROM="ClashJudge <no-reply@clashjudge.dev>"
